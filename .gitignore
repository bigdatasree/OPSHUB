# ============================================================
# OPSHUB .gitignore — Python (FastAPI) backend + Next.js frontend
# ============================================================

# ---------- Environment & secrets ----------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging / build
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/
*.egg

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Type checkers & linters
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/

# Local databases
*.sqlite3
*.db

# ---------- Node / Next.js ----------
node_modules/
.pnp/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
next-env.d.ts

# Vercel
.vercel/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Turborepo
.turbo/

# ---------- Logs ----------
logs/
*.log

# ---------- Docker ----------
docker-compose.override.yml

# ---------- IDEs & editors ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---------- OS files ----------
.DS_Store
Thumbs.db
desktop.ini
